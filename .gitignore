# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# A05: Certificates and private keys — NEVER commit to version control
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — A05: all .env variants must be gitignored
.env
.env.local
.env.production
.env.staging
.env.development.local
.env.test.local
.env.production.local

# postgres data
pgdata/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Playwright E2E
/test-results/
/playwright-report/
/tests/e2e/fixtures/.auth/

# Claude Code (config local)
.claude/
