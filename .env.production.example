# =============================================================================
# TallerFlow — Variables de entorno de PRODUCCIÓN
# =============================================================================
# Copia este archivo a .env.production y completa CADA valor antes del deploy.
# NUNCA commitees .env.production al repositorio.
#
# Generar secretos fuertes:
#   openssl rand -base64 64   →  para AUTH_SECRET / NEXTAUTH_SECRET
#   openssl rand -base64 32   →  para CRON_SECRET
#
# Requisitos de seguridad (A02):
#   - AUTH_SECRET:    mínimo 32 caracteres aleatorios
#   - CRON_SECRET:    mínimo 32 caracteres aleatorios
#   - DATABASE_URL:   siempre con sslmode=require en producción
# =============================================================================

# ── Base de datos ──────────────────────────────────────────────────────────────
# AWS RDS PostgreSQL 16. Usar las credenciales del Secrets Manager de AWS.
# sslmode=require es obligatorio — la conexión fallará si el certificado no es válido.
DATABASE_URL=postgresql://tallerflow_app:CHANGE_ME@rds-endpoint.us-east-1.rds.amazonaws.com:5432/tallerflow_marcaje?sslmode=require

# ── Auth.js / NextAuth ─────────────────────────────────────────────────────────
# Secreto para firmar y cifrar JWTs de sesión y tokens PIN de kiosco.
# Generar con: openssl rand -base64 64
# MÍNIMO 32 caracteres — el servidor rechaza arrancar si es más corto.
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_64

# Alias requerido por NextAuth v4 (compat layer de Auth.js v5)
NEXTAUTH_SECRET=CHANGE_ME_same_value_as_AUTH_SECRET

# URL pública de la aplicación — sin trailing slash.
# Usada para validar el Origin en la protección CSRF.
NEXTAUTH_URL=https://marcaje.tallerflow.cl

# ── Entorno ────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Cron / Scheduler ──────────────────────────────────────────────────────────
# Token secreto para el endpoint /api/cron/evaluar-alertas.
# Configurar en AWS EventBridge como parte de la llamada HTTP.
# Generar con: openssl rand -base64 32
CRON_SECRET=CHANGE_ME_openssl_rand_base64_32

# ── AWS ────────────────────────────────────────────────────────────────────────
# Usadas por el pipeline de CI/CD (GitHub Actions / AWS CodePipeline).
# El rol de ejecución de ECS Fargate obtiene permisos vía IAM Role, NO
# via access keys hardcodeadas — no incluir AWS_ACCESS_KEY_ID aquí.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ECR — imagen Docker del servidor Next.js + Socket.io
ECR_REPOSITORY=tallerflow-marcaje

# ECS — cluster y servicio donde se despliega la app
ECS_CLUSTER=tallerflow-prod
ECS_SERVICE=tallerflow-marcaje-service

# ── Monitoreo (opcional) ───────────────────────────────────────────────────────
# Sentry para error tracking en producción.
# Crear proyecto en https://sentry.io y obtener el DSN.
# SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/789012

# ── Checklist de deploy ────────────────────────────────────────────────────────
# Antes de cada deploy a producción, verificar:
# [ ] AUTH_SECRET tiene >= 32 caracteres únicos generados con openssl
# [ ] NEXTAUTH_SECRET == AUTH_SECRET (mismo valor)
# [ ] DATABASE_URL incluye sslmode=require
# [ ] NEXTAUTH_URL apunta al dominio correcto (sin trailing slash)
# [ ] CRON_SECRET configurado en EventBridge con el mismo valor
# [ ] .env.production NO está commiteado en git (verificar con: git status)
