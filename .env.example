# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/tallerflow_marcaje"

# ── NextAuth / Auth.js ─────────────────────────────────────────────────────────
# A02 REQUIREMENT: AUTH_SECRET must be a cryptographically random string of
# at least 32 characters. Generate with: openssl rand -base64 32
# NEVER reuse the development secret in production.
AUTH_SECRET=""
NEXTAUTH_SECRET=""        # Auth.js v4 fallback — set to same value as AUTH_SECRET
NEXTAUTH_URL="http://localhost:3000"

# ── Kiosco ─────────────────────────────────────────────────────────────────────
# Nombre exacto de la sucursal asignada a este terminal kiosco.
# Cada despliegue físico tendrá su propio valor (Antofagasta, Calama, etc.).
# Sin valor → se usa la primera sucursal activa en orden alfabético.
KIOSCO_SUCURSAL_NOMBRE=""

# ── Cron / Scheduler ──────────────────────────────────────────────────────────
# A02 REQUIREMENT: Set a random secret of >= 32 chars in production.
# Without this, the /api/cron/evaluar-alertas endpoint is blocked in production.
# Generate with: openssl rand -base64 32
CRON_SECRET=""
